            <xpath>/Defs/PreceptDef[defName="VME_Fishing_Forbidden"]/description</xpath>
            <value>
              <!-- EN: Fish are animals, and as such fishing should be a banned activity. -->
              <description>Los peces son animales y, como tales, la pesca debería ser una actividad prohibida.</description>
