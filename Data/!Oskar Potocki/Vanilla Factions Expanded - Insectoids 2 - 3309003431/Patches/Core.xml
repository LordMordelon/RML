<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/FactionDef[defName="Insect"]/label</xpath>
    <value>
      <!-- EN: hive -->
      <label>colmena</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/FactionDef[defName="Insect"]/description</xpath>
    <value>
      <!-- EN: A result of a galaxy wide experiment gone wrong, this monstrous hive-mind has made this planet their home. Divided into castes, their society relies on the giant queen.\n\nThese insectoids are not interested in diplomacy. They will try to eliminate anything that they perceive to be a threat. -->
      <description>Resultado de un experimento a escala galáctica que salió mal, esta monstruosa mente-colmena ha hecho de este planeta su hogar. Divididos en castas, su sociedad depende de la reina gigante.\n\nEstos insectoides no están interesados en la diplomacia. Intentarán eliminar cualquier cosa que perciban como una amenaza.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/FactionDef[defName="Insect"]/fixedName</xpath>
    <value>
      <!-- EN: Hive -->
      <fixedName>Colmena</fixedName>
    </value>
  </Operation>
</Patch>