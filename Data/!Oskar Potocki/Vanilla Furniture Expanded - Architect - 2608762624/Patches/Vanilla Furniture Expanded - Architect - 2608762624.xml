<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/TerrainDef[defName="VFEArch_FineSteelTile"]/label</xpath>
          <value>
            <!-- EN: fine steel tile -->
            <label>baldosa fina de acero</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/TerrainDef[defName="VFEArch_FineSilverTile"]/label</xpath>
          <value>
            <!-- EN: fine silver tile -->
            <label>baldosa fina de plata</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/TerrainDef[defName="VFEArch_FineGoldTile"]/label</xpath>
          <value>
            <!-- EN: fine gold tile -->
            <label>baldosa fina de oro</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/DesignatorDropdownGroupDef[defName="VFEArch_FineMetalFloor"]/label</xpath>
          <value>
            <!-- EN: fine metal floor -->
            <label>piso fino de metal</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>