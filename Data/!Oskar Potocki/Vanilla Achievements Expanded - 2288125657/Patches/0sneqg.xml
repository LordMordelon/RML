<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Anomaly</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/AchievementsExpanded.AchievementDef[defName="VAE_PlantsVsZombies"]/label</xpath>
            <value>
              <!-- EN: Plants Vs Zombies -->
              <label>Plantas Vs Zombis</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/AchievementsExpanded.AchievementDef[defName="VAE_PlantsVsZombies"]/description</xpath>
            <value>
              <!-- EN: Have a clawer dryad kill a shambler swarmer -->
              <description>Haz que una dríada garra mate a un enjambrador trastabillante</description>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
</Patch>