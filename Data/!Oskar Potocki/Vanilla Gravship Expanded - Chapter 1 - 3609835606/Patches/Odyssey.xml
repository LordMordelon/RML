<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/DesignationCategoryDef[defName="Odyssey"]/label</xpath>
    <value>
      <!-- EN: Gravship -->
      <label>Gravinave</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="ChemfuelTank"]/label</xpath>
    <value>
      <!-- EN: small astrofuel tank -->
      <label>tanque pequeño de astrobustible</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="ChemfuelTank"]/description</xpath>
    <value>
      <!-- EN: An astrofuel storage tank that supplies fuel for thrusters on a gravship. -->
      <description>Un tanque de almacenamiento de astrobustible que suministra combustible para los propulsores de una gravinave.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="LargeChemfuelTank"]/label</xpath>
    <value>
      <!-- EN: large astrofuel tank -->
      <label>tanque grande de astrobustible</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="LargeChemfuelTank"]/description</xpath>
    <value>
      <!-- EN: A massive astrofuel storage tank that supplies fuel for thrusters on a gravship. -->
      <description>Un tanque de almacenamiento de astrobustible masivo que suministra combustible para los propulsores de una gravinave.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="GravcorePowerCell"]/description</xpath>
    <value>
      <!-- EN: A power generator that passively draws a small amount of energy from gravitational waves passing through the gravship. Adjacent gravcore power cells will multiply their power output by 15% for each gravcore power cell. -->
      <description>Un generador de energía que extrae pasivamente una pequeña cantidad de energía de las ondas gravitacionales que atraviesan la gravinave. Las celdas de energía de gravinúcleo adyacentes multiplicarán su producción de energía en un 15% por cada celda de energía de gravinúcleo.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="GravFieldExtender"]/description</xpath>
    <value>
      <!-- EN: An ultratech device used to increase the size of a gravship. It extends the area in which substructure can be built, and increases the amount of substructure that a gravship can support. Must be built near a grav engine. A gravship can support up to ten grav field extenders. -->
      <description>Un dispositivo ultratecnológico utilizado para aumentar el tamaño de una gravinave. Extiende el área en la que se puede construir la subestructura y aumenta la cantidad de subestructura que una gravinave puede soportar. Debe construirse cerca de un motor gravitacional. Una gravinave puede soportar hasta diez extensores de campo gravitacional.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualBehaviorDef[defName="GravshipLaunch"]/roles/li[3]/label</xpath>
    <value>
      <!-- EN: gravtech researcher -->
      <label>gravinvestigador</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualBehaviorDef[defName="GravshipLaunch"]/roles/li[4]/label</xpath>
    <value>
      <!-- EN: gravtech engineer -->
      <label>gravingeniero</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[7]/label</xpath>
    <value>
      <!-- EN: {PAWN_labelShort}&apos;s research ability -->
      <label>habilidad de investigación de {PAWN_labelShort}</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[7]/labelAbstract</xpath>
    <value>
      <!-- EN: gravtech researcher&apos;s research ability -->
      <labelAbstract>habilidad de investigación del gravinvestigador</labelAbstract>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[8]/label</xpath>
    <value>
      <!-- EN: {PAWN_labelShort}&apos;s maintenance ability -->
      <label>habilidad de mantenimiento de {PAWN_labelShort}</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[8]/labelAbstract</xpath>
    <value>
      <!-- EN: gravtech engineer&apos;s maintenance ability -->
      <labelAbstract>habilidad de mantenimiento del gravingeniero</labelAbstract>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[9]/label</xpath>
    <value>
      <!-- EN: giant thrusters -->
      <label>propulsores gigantes</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[10]/label</xpath>
    <value>
      <!-- EN: Average maintenance of the gravship -->
      <label>Mantenimiento promedio de la gravinave</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[11]/label</xpath>
    <value>
      <!-- EN: manned copilot console -->
      <label>consola de copiloto tripulada</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[12]/label</xpath>
    <value>
      <!-- EN: landing near grav anchor -->
      <label>aterrizaje cerca del ancla gravitacional</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/QuestScriptDef[defName="MechanoidSignal"]/questNameRules/rulesStrings/li[1]</xpath>
    <value>
      <!-- EN: questName-&gt;runaway gravjumper -->
      <li>questName-&gt;gravisaltador fugitivo</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/QuestScriptDef[defName="MechanoidSignal"]/questDescriptionRules/rulesStrings/li[1]</xpath>
    <value>
      <!-- EN: questDescription-&gt; You&apos;ve been contacted by the Trading Guild with an urgent offer. One of their gravships carrying classified and dangerous cargo has gone rogue. The crew is presumed dead, and the ship is now on a collision course with one of their orbital platforms. It is also closely followed by a mechanoid swarm.\n\nTo avoid further catastrophe, they propose to redirect the ship to crash near your location. In return, they grant you the salvage rights. The vessel will be heavily damaged, but its gravjumper engine should remain intact.\n\nBe warned: as soon as it crashes, the pursuing mechanoids will descend on your position.\n\nGravships are rare and powerful vessels, built to traverse planetary surfaces and breach low orbit without rockets. Owning even a damaged one could change the course of your colony’s future. -->
      <li>questDescription-&gt;Has sido contactado por el Gremio de Comerciantes con una oferta urgente. Una de sus gravinaves que transportaba carga clasificada y peligrosa se ha vuelto rebelde. Se presume que la tripulación está muerta y la nave está ahora en curso de colisión con una de sus plataformas orbitales. También es seguida de cerca por un enjambre de mecanoides.\n\nPara evitar una catástrofe mayor, proponen redirigir la nave para que se estrelle cerca de tu ubicación. A cambio, te otorgan los derechos de salvamento. La nave estará muy dañada, pero su motor gravisaltador debería permanecer intacto.\n\nTen cuidado: tan pronto como se estrelle, los mecanoides perseguidores descenderán sobre tu posición.\n\nLas gravinaves son naves raras y poderosas, construidas para atravesar superficies planetarias y alcanzar la órbita baja sin cohetes. Poseer incluso una dañada podría cambiar el curso del futuro de tu colonia.</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/QuestScriptDef[defName="MechanoidSignal"]/questDescriptionRules/rulesStrings/li[2]</xpath>
    <value>
      <!-- EN: gravEngineSpawnedLetterLabel-&gt;wrecked gravjumper engine -->
      <li>gravEngineSpawnedLetterLabel-&gt;motor de salto gravitacional destrozado</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/QuestScriptDef[defName="MechanoidSignal"]/questDescriptionRules/rulesStrings/li[3]</xpath>
    <value>
      <!-- EN: gravEngineSpawnedLetterText-&gt;The damaged Trading Guild vessel has crashlanded nearby.\n\nAmidst the wreckage, you spot a functional gravjumper engine: a compact gravity manipulation core used to lift ships from planetary surfaces into orbit. The ship seems badly damaged, and substantial repair will be required.\n\n\n\nInspect the engine to make use of it and unlock the basic gravtech research project. -->
      <li>gravEngineSpawnedLetterText-&gt;La nave dañada del Gremio de Comerciantes se ha estrellado cerca.\n\nEntre los restos, ves un motor de salto gravitacional funcional: un núcleo compacto de manipulación de gravedad utilizado para elevar naves desde superficies planetarias hasta la órbita. La nave parece muy dañada y requerirá una reparación sustancial.\n\n\n\nInspecciona el motor para usarlo y desbloquear el proyecto de investigación de gravitecnología básica.</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="BasicGravtech"]/description</xpath>
    <value>
      <!-- EN: Refine chemfuel into astrofuel and store it in pressurized tanks. Unlocks the construction of the gravjumper engine, allowing the first steps into gravship travel. -->
      <description>Refina el quimbustible en astrobustible y almacénalo en tanques presurizados. Desbloquea la construcción del motor gravisaltador, permitiendo los primeros pasos en los viajes con gravinaves.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="OrbitalTech"]/description</xpath>
    <value>
      <!-- EN: Build vac barriers to protect against depressurization, and orbital scanners to detect locations in space. -->
      <description>Construye barreras de vacío para proteger contra la despresurización y escáneres orbitales para detectar ubicaciones en el espacio.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="StandardGravtech"]/description</xpath>
    <value>
      <!-- EN: Unlock gravship engines capable of lifting a colony into orbit. Allows construction of control terminals for new gravship systems such as gravtech research and maintenance. -->
      <description>Desbloquea motores de gravinaves capaces de elevar una colonia a la órbita. Permite la construcción de terminales de control para nuevos sistemas de gravinaves, como la investigación y el mantenimiento de gravitecnología.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="AdvancedGravtech"]/description</xpath>
    <value>
      <!-- EN: Unlock gravhulks, massive gravships capable of supporting entire colonies. Also allows crafting of gravlite panels, essential ultratech material for advanced gravship construction. -->
      <description>Desbloquea los gravicolosos, gravinaves masivas capaces de soportar colonias enteras. También permite la fabricación de paneles de gravilita, material ultratecnológico esencial para la construcción avanzada de gravinaves.</description>
    </value>
  </Operation>
</Patch>