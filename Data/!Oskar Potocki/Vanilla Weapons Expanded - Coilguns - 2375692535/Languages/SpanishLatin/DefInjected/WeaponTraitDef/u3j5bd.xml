<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- EN: inertial core -->
  <VWE_InertialCore.label>núcleo inercial</VWE_InertialCore.label>
  <!-- EN: This weapon maintains absolute kinetic energy during overcharge, ensuring each consecutively pierced target takes the exact same amount of damage without falloff. -->
  <VWE_InertialCore.description>Esta arma mantiene la energía cinética absoluta durante la sobrecarga, garantizando que cada objetivo perforado consecutivamente reciba exactamente la misma cantidad de daño, sin pérdida.</VWE_InertialCore.description>
  <!-- EN: piercing -->
  <VWE_InertialCore.traitAdjectives.0>perforante</VWE_InertialCore.traitAdjectives.0>
  <!-- EN: unstoppable -->
  <VWE_InertialCore.traitAdjectives.1>imparable</VWE_InertialCore.traitAdjectives.1>
  <!-- EN: inertial -->
  <VWE_InertialCore.traitAdjectives.2>inercial</VWE_InertialCore.traitAdjectives.2>
  <!-- EN: penetrating -->
  <VWE_InertialCore.traitAdjectives.3>penetrante</VWE_InertialCore.traitAdjectives.3>
  <!-- EN: constant -->
  <VWE_InertialCore.traitAdjectives.4>constante</VWE_InertialCore.traitAdjectives.4>
  <!-- EN: bypass relay -->
  <VWE_BypassRelay.label>relé de derivación</VWE_BypassRelay.label>
  <!-- EN: This weapon features an optimized charging sequence that halves the aiming time normally required to fire in high-power mode. -->
  <VWE_BypassRelay.description>Esta arma cuenta con una secuencia de carga optimizada que reduce a la mitad el tiempo de apuntado normalmente necesario para disparar en modo de alta potencia.</VWE_BypassRelay.description>
  <!-- EN: quick-charge -->
  <VWE_BypassRelay.traitAdjectives.0>de carga rápida</VWE_BypassRelay.traitAdjectives.0>
  <!-- EN: swift -->
  <VWE_BypassRelay.traitAdjectives.1>veloz</VWE_BypassRelay.traitAdjectives.1>
  <!-- EN: bypass -->
  <VWE_BypassRelay.traitAdjectives.2>de derivación</VWE_BypassRelay.traitAdjectives.2>
  <!-- EN: optimized -->
  <VWE_BypassRelay.traitAdjectives.3>de alto rendimiento</VWE_BypassRelay.traitAdjectives.3>
  <!-- EN: snap-shot -->
  <VWE_BypassRelay.traitAdjectives.4>de tiro instantáneo</VWE_BypassRelay.traitAdjectives.4>
  <!-- EN: overdrawn coils -->
  <VWE_OverdrawnCoils.label>bobinas sobreexcitadas</VWE_OverdrawnCoils.label>
  <!-- EN: This weapon draws excessive power from its reserves during high-power mode, taking slightly longer to charge but delivering vastly increased damage. -->
  <VWE_OverdrawnCoils.description>Esta arma extrae una potencia excesiva de sus reservas durante el modo de alta potencia, por lo que tarda un poco más en cargar, pero inflige un daño enormemente superior.</VWE_OverdrawnCoils.description>
  <!-- EN: overdrawn -->
  <VWE_OverdrawnCoils.traitAdjectives.0>de sobrecarga</VWE_OverdrawnCoils.traitAdjectives.0>
  <!-- EN: heavy-charge -->
  <VWE_OverdrawnCoils.traitAdjectives.1>de carga pesada</VWE_OverdrawnCoils.traitAdjectives.1>
  <!-- EN: devastating -->
  <VWE_OverdrawnCoils.traitAdjectives.2>de destrucción</VWE_OverdrawnCoils.traitAdjectives.2>
  <!-- EN: slow-burn -->
  <VWE_OverdrawnCoils.traitAdjectives.3>de combustión lenta</VWE_OverdrawnCoils.traitAdjectives.3>
  <!-- EN: amplified -->
  <VWE_OverdrawnCoils.traitAdjectives.4>de potencia amplificada</VWE_OverdrawnCoils.traitAdjectives.4>
  <!-- EN: ionized sabot -->
  <VWE_IonizedSabot.label>sabot ionizado</VWE_IonizedSabot.label>
  <!-- EN: This weapon magnetizes its projectiles with volatile energy, increasing damage across all firing modes. -->
  <VWE_IonizedSabot.description>Esta arma magnetiza sus proyectiles con energía volátil, aumentando el daño en todos los modos de disparo.</VWE_IonizedSabot.description>
  <!-- EN: ionized -->
  <VWE_IonizedSabot.traitAdjectives.0>de iones</VWE_IonizedSabot.traitAdjectives.0>
  <!-- EN: azure -->
  <VWE_IonizedSabot.traitAdjectives.1>azur</VWE_IonizedSabot.traitAdjectives.1>
  <!-- EN: plasma -->
  <VWE_IonizedSabot.traitAdjectives.2>de plasma</VWE_IonizedSabot.traitAdjectives.2>
  <!-- EN: glowing -->
  <VWE_IonizedSabot.traitAdjectives.3>incandescente</VWE_IonizedSabot.traitAdjectives.3>
  <!-- EN: charged -->
  <VWE_IonizedSabot.traitAdjectives.4>con carga</VWE_IonizedSabot.traitAdjectives.4>
  <!-- EN: low power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverride.Verb_Shoot-0.label>disparo de baja potencia</VWE_IonizedSabot.modExtensions.0.verbsOverride.Verb_Shoot-0.label>
  <!-- EN: high power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverride.Verb_Shoot-1.label>disparo de alta potencia</VWE_IonizedSabot.modExtensions.0.verbsOverride.Verb_Shoot-1.label>
  <!-- EN: low power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverrides.0.value.Verb_Shoot-0.label>disparo de baja potencia</VWE_IonizedSabot.modExtensions.0.verbsOverrides.0.value.Verb_Shoot-0.label>
  <!-- EN: high power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverrides.0.value.Verb_Shoot-1.label>disparo de alta potencia</VWE_IonizedSabot.modExtensions.0.verbsOverrides.0.value.Verb_Shoot-1.label>
  <!-- EN: low power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverrides.1.value.Verb_Shoot-0.label>disparo de baja potencia</VWE_IonizedSabot.modExtensions.0.verbsOverrides.1.value.Verb_Shoot-0.label>
  <!-- EN: high power shot -->
  <VWE_IonizedSabot.modExtensions.0.verbsOverrides.1.value.Verb_Shoot-1.label>disparo de alta potencia</VWE_IonizedSabot.modExtensions.0.verbsOverrides.1.value.Verb_Shoot-1.label>
  <!-- EN: hypercapacitors -->
  <VWE_Hypercapacitors.label>hipercondensadores</VWE_Hypercapacitors.label>
  <!-- EN: This weapon is fitted with advanced energy banks that double the possible burst count for all shots, though the resulting rapid-fire sequence no longer guarantees armor penetration. -->
  <VWE_Hypercapacitors.description>Esta arma está equipada con bancos de energía avanzados que duplican la cantidad posible de disparos por ráfaga, aunque la secuencia de fuego rápido resultante ya no garantiza la penetración de blindaje.</VWE_Hypercapacitors.description>
  <!-- EN: hyper-burst -->
  <VWE_Hypercapacitors.traitAdjectives.0>de hiperráfaga</VWE_Hypercapacitors.traitAdjectives.0>
  <!-- EN: rapid-discharge -->
  <VWE_Hypercapacitors.traitAdjectives.1>de descarga rápida</VWE_Hypercapacitors.traitAdjectives.1>
  <!-- EN: showering -->
  <VWE_Hypercapacitors.traitAdjectives.2>torrencial</VWE_Hypercapacitors.traitAdjectives.2>
  <!-- EN: capacitor -->
  <VWE_Hypercapacitors.traitAdjectives.3>de condensador</VWE_Hypercapacitors.traitAdjectives.3>
  <!-- EN: twin-linked -->
  <VWE_Hypercapacitors.traitAdjectives.4>de enlace doble</VWE_Hypercapacitors.traitAdjectives.4>
  <!-- EN: inverted rail tuning -->
  <VWE_InvertedRailTuning.label>calibrado de rieles invertido</VWE_InvertedRailTuning.label>
  <!-- EN: This weapon is radically tuned to deliver devastating low-power shots at close range while reserving its high-power mode for sweeping but less lethal long-range engagements. -->
  <VWE_InvertedRailTuning.description>Esta arma está calibrada de forma radical para asestar devastadores disparos de baja potencia a corta distancia, reservando su modo de alta potencia para enfrentamientos a larga distancia, más amplios pero menos letales.</VWE_InvertedRailTuning.description>
  <!-- EN: inverted -->
  <VWE_InvertedRailTuning.traitAdjectives.0>de polaridad inversa</VWE_InvertedRailTuning.traitAdjectives.0>
  <!-- EN: bipolar -->
  <VWE_InvertedRailTuning.traitAdjectives.1>bipolar</VWE_InvertedRailTuning.traitAdjectives.1>
  <!-- EN: tuned -->
  <VWE_InvertedRailTuning.traitAdjectives.2>de calibración fina</VWE_InvertedRailTuning.traitAdjectives.2>
  <!-- EN: split-range -->
  <VWE_InvertedRailTuning.traitAdjectives.3>de doble alcance</VWE_InvertedRailTuning.traitAdjectives.3>
  <!-- EN: erratic -->
  <VWE_InvertedRailTuning.traitAdjectives.4>impredecible</VWE_InvertedRailTuning.traitAdjectives.4>
</LanguageData>