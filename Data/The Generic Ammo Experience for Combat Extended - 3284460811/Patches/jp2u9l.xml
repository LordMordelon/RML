<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Tribals</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Vanilla Weapons Expanded</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="VWE_MeleeWeapon_Axe"]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: handle -->
              <label>mango</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="VWE_MeleeWeapon_Axe"]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: edge -->
              <label>filo</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="VWE_MeleeWeapon_Axe"]/description</xpath>
            <value>
              <!-- EN: A simple axe head fastened to a handle. The wedge-shaped axe head allows the weapon to easily cut into flesh and makes it an effective weapon for one-handed combat. -->
              <description>Una cabeza de hacha simple sujeta a un mango. Su forma de cuña le permite al arma cortar la carne con facilidad y la convierte en un arma eficaz para el combate a una mano.</description>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Weapons Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_TrenchGun"]/description</xpath>
          <value>
            <!-- EN: A heavy shotgun that packs a bigger punch than its regular pump-action counterparts. -->
            <description>Una escopeta pesada que golpea con más fuerza que las escopetas comunes de acción de bombeo.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_SMG"]/label</xpath>
          <value>
            <!-- EN: carbine -->
            <label>carabina</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_SMG"]/description</xpath>
          <value>
            <!-- EN: A compact carbine design, featuring a short-stroke gas piston system to improve reliability and reduce recoil. -->
            <description>Una carabina compacta, con un sistema de pistón de gas de carrera corta que mejora la fiabilidad y reduce el retroceso.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_LightSMG"]/label</xpath>
          <value>
            <!-- EN: SMG -->
            <label>SMG</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_LightSMG"]/description</xpath>
          <value>
            <!-- EN: A compact submachine gun. Whilst it doesn&apos;t have long range of fire, it deals significant damage in close range. -->
            <description>Un subfusil compacto. Aunque no tiene mucho alcance, causa un daño considerable a corta distancia.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_MarksmanRifle"]/description</xpath>
          <value>
            <!-- EN: A designated marksman rifle capable of firing rifle caliber rounds at extended ranges. -->
            <description>Un fusil de tirador designado capaz de disparar proyectiles de calibre de fusil a grandes distancias.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VWE_Gun_HMG"]/label</xpath>
          <value>
            <!-- EN: heavy machine gun -->
            <label>ametralladora pesada</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>