<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="ShieldBelt"]/label</xpath>
          <value>
            <!-- EN: power shields -->
            <label>escudos de energía</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Armour Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Apparel_PlateArmor"]/description</xpath>
          <value>
            <!-- EN: Overlapping solid plates of armor cover the bulk of the body. When paired with plate boots, gloves and a helmet this armor offers complete head-to-toe protection. -->
            <description>Placas sólidas solapadas de armadura que cubren la mayor parte del cuerpo. Junto con las botas, los guantes y el casco de placas, esta armadura ofrece una protección completa de la cabeza a los pies.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Medieval 2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="Greatbow"]/label</xpath>
          <value>
            <!-- EN: greatbows -->
            <label>arcos grandes</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="Greatbow"]/generalRules/rulesStrings/li[6]</xpath>
          <value>
            <!-- EN: subject-&gt;warbows -->
            <li>subject-&gt;arcos de guerra</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>