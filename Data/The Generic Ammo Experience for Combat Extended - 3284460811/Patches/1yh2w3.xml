<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Apparel Expanded — Accessories</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VAEA_Apparel_Quiver"]/description</xpath>
          <value>
            <!-- EN: A quiver for arrows. Halves the warmup time of simple ranged weapons. Firearms and other advanced weapons are unaffected. -->
            <description>TODO</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VAEA_Apparel_AmmoPack"]/description</xpath>
          <value>
            <!-- EN: A pouch with a shoulder strap for storing ammunition. Also allows the wearer to easily access ammunition during combat which speeds up reloads. -->
            <description>TODO</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>