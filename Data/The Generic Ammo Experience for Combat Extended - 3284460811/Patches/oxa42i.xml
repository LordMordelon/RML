<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Empire</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_HEShellsDrop"]/label</xpath>
          <value>
            <!-- EN: mortar shells drop -->
            <label>solicitar obuses de mortero</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_HEShellsDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 10 high-explosive mortar shells. -->
            <description>Solicita un pedido de transporte aéreo de 10 obuses de mortero explosivos.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>