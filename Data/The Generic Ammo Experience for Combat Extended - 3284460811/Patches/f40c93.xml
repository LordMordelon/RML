<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Security</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VFES_AmmoCrate"]/description</xpath>
          <value>
            <!-- EN: A crate for storing ammunition. Improves the reload speed of surrounding soldiers. -->
            <description>Una caja para guardar munición. Mejora la velocidad de recarga de los soldados cercanos.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>