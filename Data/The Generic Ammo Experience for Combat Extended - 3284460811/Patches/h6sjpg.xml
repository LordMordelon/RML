<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Shell_Toxic"]/label</xpath>
          <value>
            <!-- EN: tox mortar shell -->
            <label>obús de mortero tóxico</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>