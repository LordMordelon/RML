<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationSequence" MayRequireAnyOf="CETeam.CombatExtended,CETeam.CombatExtended_steam">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="DMSE_Modular_AR"]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: stock -->
              <label>culata</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="DMSE_Modular_AR"]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: barrel -->
              <label>cañón</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="DMSE_Modular_AR"]/tools/li[3]/label</xpath>
            <value>
              <!-- EN: muzzle -->
              <label>boca del cañón</label>
            </value>
          </li>
        </operations>
      </li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="DMSE_FuelSiloTank"]/label</xpath>
          <value>
            <!-- EN: Astrofuel silo -->
            <label>silo de astrobustible</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="DMSE_FuelTankSmall"]/label</xpath>
          <value>
            <!-- EN: small astrofuel silo -->
            <label>silo de astrobustible pequeño</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>