<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
      <li>##packageId##CETeam.CombatExtended_steam</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Rifle"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: barrel -->
            <label>cañón</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Rifle"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: bayonet blade -->
            <label>hoja de bayoneta</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Rifle"]/tools/li[3]/label</xpath>
          <value>
            <!-- EN: bayonet point -->
            <label>punta de bayoneta</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_SMG"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: barrel -->
            <label>cañón</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_SMG"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: handle -->
            <label>mango</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_PT"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: barrel -->
            <label>cañón</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_PT"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: handle -->
            <label>mango</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Dagger"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: handle -->
            <label>mango</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Dagger"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: point -->
            <label>punta</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AMP_Weapon_Dagger"]/tools/li[3]/label</xpath>
          <value>
            <!-- EN: edge -->
            <label>filo</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>