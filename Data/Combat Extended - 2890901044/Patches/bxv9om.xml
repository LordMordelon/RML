        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Mono"]/comps/li[1]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: edge -->
              <label>filo</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Mono"]/comps/li[1]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: point -->
              <label>punta</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Plasma"]/comps/li[1]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: edge -->
              <label>filo</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Plasma"]/comps/li[1]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: point -->
              <label>punta</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Zeus"]/comps/li[1]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: edge -->
              <label>filo</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Zeus"]/comps/li[1]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: point -->
              <label>punta</label>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Empire</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Altered Carbon 2: ReSleeved</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Toxblade"]/comps/li[1]/tools/li[1]/label</xpath>
            <value>
              <!-- EN: edge -->
              <label>filo</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade_Toxblade"]/comps/li[1]/tools/li[2]/label</xpath>
            <value>
              <!-- EN: point -->
              <label>punta</label>
