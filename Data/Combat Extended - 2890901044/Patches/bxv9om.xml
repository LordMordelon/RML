<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Altered Carbon 2: ReSleeved</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade"]/comps/li[1]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: blade -->
            <label>hoja</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/HediffDef[defName="AC_RogianArmBlade"]/comps/li[1]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: blade -->
            <label>hoja</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AC_Gun_Autorevolver"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: grip -->
            <label>empuñadura</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AC_Gun_Autorevolver"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: muzzle -->
            <label>boca del cañón</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
