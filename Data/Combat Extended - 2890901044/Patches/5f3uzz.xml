<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Biomes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AB_Shell_Tar"]/label</xpath>
          <value>
            <!-- EN: 81mm mortar shell (Tar) -->
            <label>obús de mortero 81mm (alquitrán)</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>