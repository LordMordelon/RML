<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Memes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AM_Dryad_Spitter"]/verbs/*[.//*[contains(text(), 'Verb_ShootCE')]]/label</xpath>
          <value>
            <!-- EN: venomous spit -->
            <label>escupitajo venenoso</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AM_UnshackledDryad"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: left claw -->
            <label>garra izquierda</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AM_UnshackledDryad"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: right claw -->
            <label>garra derecha</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="AM_UnshackledDryad"]/tools/li[4]/label</xpath>
          <value>
            <!-- EN: head -->
            <label>cabeza</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>