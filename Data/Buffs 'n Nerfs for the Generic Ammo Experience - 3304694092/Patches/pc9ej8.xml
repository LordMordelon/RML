<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Weapons Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="GasOperation"]/description</xpath>
          <value>
            <!-- EN: Craft high-power guns capable of sustained automatic fire. -->
            <description>Fabrica armas potentes capaces de mantener el fuego automático.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="BlowbackOperation"]/description</xpath>
          <value>
            <!-- EN: Craft low-power blowback-operated guns like semi-automatic rifles and machine pistols. -->
            <description>Fabrica armas de baja potencia accionadas por retroceso, como fusiles semiautomáticos y pistolas ametralladoras.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="Gunsmithing"]/description</xpath>
          <value>
            <!-- EN: Learn to build firearms and craft simple manually-operated repeaters. -->
            <description>Aprende a construir armas de fuego y a fabricar armas de repetición simples de accionamiento manual.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>