  <FFF_Info_CausePanic.description>TODO</FFF_Info_CausePanic.description>
  <!-- EN: hovering -->
  <FFF_Info_Floating.label>TODO</FFF_Info_Floating.label>
  <!-- EN: This unit hovers above the ground. It ignores terrain that would slow a walker and can cross deep water. -->
  <FFF_Info_Floating.description>TODO</FFF_Info_Floating.description>
  <!-- EN: air support -->
  <FFF_Info_AirSupportSummoner.label>TODO</FFF_Info_AirSupportSummoner.label>
