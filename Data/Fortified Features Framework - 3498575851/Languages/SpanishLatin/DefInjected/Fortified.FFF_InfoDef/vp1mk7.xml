  <FFF_Info_EnvironmentExemption.description>TODO</FFF_Info_EnvironmentExemption.description>
  <!-- EN: fueled production -->
  <FFF_Info_FueledSpawner.label>TODO</FFF_Info_FueledSpawner.label>
