  <FFF_Info_ConeExplosive.label>TODO</FFF_Info_ConeExplosive.label>
  <!-- EN: On impact this projectile explodes in a cone pointing along its direction of travel instead of a full circle. Anything in the arc ahead of the impact point is hit; things behind or beside it are spared. Aim it so the cone sweeps across the enemy line. -->
  <FFF_Info_ConeExplosive.description>TODO</FFF_Info_ConeExplosive.description>
