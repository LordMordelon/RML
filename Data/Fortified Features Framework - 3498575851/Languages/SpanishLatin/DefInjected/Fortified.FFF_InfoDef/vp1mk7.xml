  <FFF_Info_AirSupportSummoner.description>TODO</FFF_Info_AirSupportSummoner.description>
  <!-- EN: reloadable weapon -->
  <FFF_Info_WeaponReloadable.label>TODO</FFF_Info_WeaponReloadable.label>
  <!-- EN: This weapon carries a limited number of charges and must be reloaded with the matching ammunition item once they are spent. -->
  <FFF_Info_WeaponReloadable.description>TODO</FFF_Info_WeaponReloadable.description>
  <!-- EN: paintable -->
  <FFF_Info_Paintable.label>TODO</FFF_Info_Paintable.label>
  <!-- EN: Can be repainted. Choose a color or camouflage pattern from the paint command; some models default to their faction&apos;s colors. -->
  <FFF_Info_Paintable.description>TODO</FFF_Info_Paintable.description>
