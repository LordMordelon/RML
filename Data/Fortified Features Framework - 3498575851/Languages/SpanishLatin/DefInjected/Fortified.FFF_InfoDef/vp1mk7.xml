  <FFF_Info_LogisticTerminal.label>TODO</FFF_Info_LogisticTerminal.label>
  <!-- EN: Interact with the terminal to request a delivery. After a delay a cargo cart arrives carrying a portion of the terminal&apos;s stock; the stock is limited and the terminal shuts down once it is exhausted. -->
  <FFF_Info_LogisticTerminal.description>TODO</FFF_Info_LogisticTerminal.description>
  <!-- EN: stocked container -->
  <FFF_Info_ListedContainer.label>TODO</FFF_Info_ListedContainer.label>
  <!-- EN: A container holding supplies. Inspect it to see the contents, then interact with it to unload them. -->
  <FFF_Info_ListedContainer.description>TODO</FFF_Info_ListedContainer.description>
  <!-- EN: sealed cache -->
  <FFF_Info_Lootbox.label>TODO</FFF_Info_Lootbox.label>
  <!-- EN: A sealed container. Opening it yields a random selection of goods — or occasionally nothing at all. -->
  <FFF_Info_Lootbox.description>TODO</FFF_Info_Lootbox.description>
  <!-- EN: trampling -->
  <FFF_Info_TrampleBuildings.label>TODO</FFF_Info_TrampleBuildings.label>
  <!-- EN: This unit is heavy enough to crush structures in its way. Buildings within its footprint that do not belong to its faction take damage as it moves through them. -->
  <FFF_Info_TrampleBuildings.description>TODO</FFF_Info_TrampleBuildings.description>
  <!-- EN: sweeping strike -->
  <FFF_Info_MeleeSweep.label>TODO</FFF_Info_MeleeSweep.label>
  <!-- EN: Melee attacks hit everything in a cone in front of the attacker rather than a single target. -->
  <FFF_Info_MeleeSweep.description>TODO</FFF_Info_MeleeSweep.description>
  <!-- EN: armor plates -->
  <FFF_Info_BulletproofPlate.label>TODO</FFF_Info_BulletproofPlate.label>
  <!-- EN: Fitted with replaceable armor plates that add protection to the body parts they cover. Plates lose durability when hit and stop protecting once worn out; replenish them with the matching plate material. Higher quality apparel gets more out of its plates. -->
  <FFF_Info_BulletproofPlate.description>TODO</FFF_Info_BulletproofPlate.description>
  <!-- EN: active protection -->
  <FFF_Info_ActiveProtectionSystem.label>TODO</FFF_Info_ActiveProtectionSystem.label>
  <!-- EN: Deploys an interception field around the user for a limited time. Incoming projectiles that enter the field have a chance to be shot down before they land; only a few can be intercepted at once. -->
  <FFF_Info_ActiveProtectionSystem.description>TODO</FFF_Info_ActiveProtectionSystem.description>
  <!-- EN: obscurant smoke -->
  <FFF_Info_AntiBlasterSmoke.label>TODO</FFF_Info_AntiBlasterSmoke.label>
  <!-- EN: Fills its area with smoke that has a chance to stop certain projectiles passing through it for as long as it lasts. -->
  <FFF_Info_AntiBlasterSmoke.description>TODO</FFF_Info_AntiBlasterSmoke.description>
  <!-- EN: intimidating presence -->
  <FFF_Info_CausePanic.label>TODO</FFF_Info_CausePanic.label>
