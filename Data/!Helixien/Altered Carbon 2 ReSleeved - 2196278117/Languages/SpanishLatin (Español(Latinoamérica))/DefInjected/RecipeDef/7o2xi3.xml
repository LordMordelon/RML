<LanguageData>
  <!-- EN: Shred neural stack -->
  <AC_ShredNeuralStacks.label>triturar pila neural</AC_ShredNeuralStacks.label>
  <!-- EN: Shred a neural stack to try to salvage usable material. -->
  <AC_ShredNeuralStacks.description>Tritura una pila neural para intentar recuperar material útil.</AC_ShredNeuralStacks.description>
  <!-- EN: Shredding neural stack. -->
  <AC_ShredNeuralStacks.jobString>Triturando pila neural.</AC_ShredNeuralStacks.jobString>
  <!-- EN: Smash neural stack -->
  <AC_SmashNeuralStacks.label>Destruir pila neural</AC_SmashNeuralStacks.label>
  <!-- EN: Smash a neural stack with simple hand tools to salvage usable material. -->
  <AC_SmashNeuralStacks.description>Destruye una pila neural con herramientas manuales simples para recuperar material útil.</AC_SmashNeuralStacks.description>
  <!-- EN: Smashing neural stack. -->
  <AC_SmashNeuralStacks.jobString>Destrozando pila neural.</AC_SmashNeuralStacks.jobString>
  <!-- EN: Reset biocoding -->
  <AC_ResetBiocodedThings.label>restablecer biocodificación</AC_ResetBiocodedThings.label>
  <!-- EN: Reset biocoded equipment to factory settings, allowing for bonding with a new person.\n\nIf unsuccessful, the item may break. -->
  <AC_ResetBiocodedThings.description>Restablece el equipo biocodificado a la configuración de fábrica, permitiendo su vinculación con una nueva persona.\n\nSi no tiene éxito, el objeto puede romperse.</AC_ResetBiocodedThings.description>
  <!-- EN: Resetting biocoded things. -->
  <AC_ResetBiocodedThings.jobString>Restableciendo objetos biocodificados.</AC_ResetBiocodedThings.jobString>
  <!-- EN: Unbound persona -->
  <AC_UnboundPersona.label>desvincular persona</AC_UnboundPersona.label>
  <!-- EN: Unbound a persona weapon from their current user, allowing for bonding with a new person.\n\nIf unsuccessful, the item may break. -->
  <AC_UnboundPersona.description>Desvincula un arma personal de su usuario actual, permitiendo su vinculación con una nueva persona.\n\nSi no tiene éxito, el objeto puede romperse.</AC_UnboundPersona.description>
  <!-- EN: Unbounding persona. -->
  <AC_UnboundPersona.jobString>Desvinculando persona.</AC_UnboundPersona.jobString>
  <!-- EN: Duplicate stack -->
  <AC_DuplicateNeuralStack.label>Duplicar pila</AC_DuplicateNeuralStack.label>
  <!-- EN: Duplicate the content of an active neural stack, effectively creating a &quot;clone&quot; or &quot;duplicate&quot; of the consciousness stored on the original stack. -->
  <AC_DuplicateNeuralStack.description>Duplica el contenido de una pila neural activa, creando efectivamente un "clon" o "duplicado" de la conciencia almacenada en la pila original.</AC_DuplicateNeuralStack.description>
  <!-- EN: Duplicating stack. -->
  <AC_DuplicateNeuralStack.jobString>Duplicando pila.</AC_DuplicateNeuralStack.jobString>
  <!-- EN: Duplicate stack -->
  <AC_DuplicateNeuralStackPawn.label>Duplicar pila</AC_DuplicateNeuralStackPawn.label>
  <!-- EN: Duplicate the content of an active neural stack, effectively creating a &quot;clone&quot; or &quot;duplicate&quot; of the consciousness stored on the original stack. -->
  <AC_DuplicateNeuralStackPawn.description>Duplica el contenido de una pila neural activa, creando efectivamente un "clon" o "duplicado" de la conciencia almacenada en la pila original.</AC_DuplicateNeuralStackPawn.description>
  <!-- EN: Duplicating stack. -->
  <AC_DuplicateNeuralStackPawn.jobString>Duplicando pila.</AC_DuplicateNeuralStackPawn.jobString>
  <!-- EN: Modify stack -->
  <AC_EditActiveNeuralStack.label>Modificar pila</AC_EditActiveNeuralStack.label>
  <!-- EN: Modify the neural data stored on an active stack. This process can take not only time, but can also be very destructive on the consciousness stored on the selected stack. -->
  <AC_EditActiveNeuralStack.description>Modifica los datos neurales almacenados en una pila activa. Este proceso no solo puede llevar tiempo, sino que también puede ser muy destructivo para la conciencia almacenada en la pila seleccionada.</AC_EditActiveNeuralStack.description>
  <!-- EN: Modifying stack. -->
  <AC_EditActiveNeuralStack.jobString>Modificando pila.</AC_EditActiveNeuralStack.jobString>
  <!-- EN: Modify stack -->
  <AC_EditActiveNeuralStackPawn.label>Modificar pila</AC_EditActiveNeuralStackPawn.label>
  <!-- EN: Modify the neural data stored on an active stack. This process can take not only time, but can also be very destructive on the consciousness stored on the selected stack. -->
  <AC_EditActiveNeuralStackPawn.description>Modifica los datos neurales almacenados en una pila activa. Este proceso no solo puede llevar tiempo, sino que también puede ser muy destructivo para la conciencia almacenada en la pila seleccionada.</AC_EditActiveNeuralStackPawn.description>
  <!-- EN: Modifying stack. -->
  <AC_EditActiveNeuralStackPawn.jobString>Modificando pila.</AC_EditActiveNeuralStackPawn.jobString>
  <!-- EN: Erase stack -->
  <AC_WipeActiveNeuralStack.label>Borrar pila</AC_WipeActiveNeuralStack.label>
  <!-- EN: Erase all content from a selected active neural stack, effectively killing the consciousness stored on it. The stack can afterwards be reused for someone else. -->
  <AC_WipeActiveNeuralStack.description>Borra todo el contenido de una pila neural activa seleccionada, matando efectivamente la conciencia almacenada en ella. La pila puede ser reutilizada después para otra persona.</AC_WipeActiveNeuralStack.description>
  <!-- EN: Erasing stack. -->
  <AC_WipeActiveNeuralStack.jobString>Borrando pila.</AC_WipeActiveNeuralStack.jobString>
