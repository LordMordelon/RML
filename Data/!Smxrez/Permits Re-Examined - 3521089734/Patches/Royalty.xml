<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RoyalTitlePermitDef[defName="FoodDrop"]/description</xpath>
    <value>
      <!-- EN: Call for a drop of 35 packaged survival meals. -->
      <description>Solicita una entrega de 35 raciones de supervivencia envasadas.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RoyalTitlePermitDef[defName="SteelDrop"]/description</xpath>
    <value>
      <!-- EN: Call for a drop of 750 steel. -->
      <description>Solicita una entrega de 750 de acero.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RoyalTitlePermitDef[defName="SilverDrop"]/description</xpath>
    <value>
      <!-- EN: Call for a drop of 1500 silver. -->
      <description>Solicita una entrega de 1500 de plata.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RoyalTitlePermitDef[defName="GlitterMedDrop"]/description</xpath>
    <value>
      <!-- EN: Call for a drop of 8 glitterworld medicine. -->
      <description>Solicita una entrega de 8 medicinas del mundobrillante.</description>
    </value>
  </Operation>
</Patch>