          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_ChemfuelDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 685 chemfuel. -->
            <description>Solicita una entrega de 685 de quimbustible.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_JadeDrop"]/description</xpath>
