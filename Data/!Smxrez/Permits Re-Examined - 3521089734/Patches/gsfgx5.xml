<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Empire</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_NobleFoodDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 25 lavish meals. -->
            <description>Solicita una entrega de 25 comidas opulentas.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_HerbalMedDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 50 herbal medicine. -->
            <description>Solicita una entrega de 50 medicinas herbales.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_MedDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 30 medicine. -->
            <description>Solicita una entrega de 30 medicinas.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_HEShellsDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 15 high-explosiveshells. -->
            <description>Solicita una entrega de 15 proyectiles altamente explosivos.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_ComponentDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 25 components. -->
            <description>Solicita una entrega de 25 componentes.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_WoodDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of 1250 wood. -->
            <description>Solicita una entrega de 1250 de madera.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
