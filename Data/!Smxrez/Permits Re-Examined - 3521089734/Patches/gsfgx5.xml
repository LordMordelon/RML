            <description>Solicita una entrega de 5 componentes avanzados</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RoyalTitlePermitDef[defName="VFEI_StrikerTurretDrop"]/description</xpath>
          <value>
            <!-- EN: Call for a drop of four striker turrets to aid you in battle. After they fire all their ammo, striker turrets self-detonate. -->
            <description>Solicita el envío de cuatro torretas de asalto para ayudarte en combate. Cuando disparan toda su munición, las torretas de asalto se autodetonan.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>