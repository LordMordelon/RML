  <!-- EN: oviparous -->
  <VRESaurids_Oviparous.label>ovíparo</VRESaurids_Oviparous.label>
  <!-- EN: Carriers of this gene lay eggs instead of giving live birth. Eggs need time and correct conditions to hatch.
		 -->
  <VRESaurids_Oviparous.description>Los portadores de este gen ponen huevos en lugar de dar a luz crías vivas. Los huevos necesitan tiempo y condiciones correctas para eclosionar.\n		</VRESaurids_Oviparous.description>
  <!-- EN: Lays eggs instead of pregnancy and live birth. -->
  <VRESaurids_Oviparous.customEffectDescriptions.0>Pone huevos en lugar de embarazo y parto vivo.</VRESaurids_Oviparous.customEffectDescriptions.0>
  <!-- EN: Laying eggs makes the pawn temporarily infertile. -->
  <VRESaurids_Oviparous.customEffectDescriptions.1>Poner huevos hace que el peón sea temporalmente infértil.</VRESaurids_Oviparous.customEffectDescriptions.1>
  <!-- EN: egglayer -->
