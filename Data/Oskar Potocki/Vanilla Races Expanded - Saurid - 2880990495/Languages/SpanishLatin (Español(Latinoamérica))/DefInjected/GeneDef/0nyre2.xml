  <!-- EN: pheromones -->
  <VRESaurids_Pheromones.label>feromonas</VRESaurids_Pheromones.label>
  <!-- EN: Carriers of this gene excrete special pheromones that attract members of the same xenotype. -->
  <VRESaurids_Pheromones.description>Los portadores de este gen excretan feromonas especiales que atraen a miembros del mismo xenotipo.</VRESaurids_Pheromones.description>
  <!-- EN: Improved relations with any pawn of the same xenotype. -->
  <VRESaurids_Pheromones.customEffectDescriptions.0>Relaciones mejoradas con cualquier peón del mismo xenotipo.</VRESaurids_Pheromones.customEffectDescriptions.0>
  <!-- EN: scaleskin -->
  <VRESaurids_ScaleSkin.label>piel de escamas</VRESaurids_ScaleSkin.label>
  <!-- EN: scaleskinned -->
  <VRESaurids_ScaleSkin.labelShortAdj>escamoso</VRESaurids_ScaleSkin.labelShortAdj>
  <!-- EN: Carriers of this gene grow scales all over their body, which protect them from sharp damage of any kind. -->
  <VRESaurids_ScaleSkin.description>Los portadores de este gen desarrollan escamas por todo su cuerpo, las cuales los protegen de daños cortantes de cualquier tipo.</VRESaurids_ScaleSkin.description>
