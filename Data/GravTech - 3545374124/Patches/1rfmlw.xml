      <mods>
        <li>Vanilla Gravship Expanded - Chapter 1</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/RitualOutcomeEffectDef[defName="VGE_GravhulkLaunch"]/comps/li[13]/label</xpath>
            <value>
              <!-- EN: Advanced ship AI core -->
              <label>Núcleo de IA de nave avanzado</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/RitualOutcomeEffectDef[defName="VGE_GravhulkLaunch"]/comps/li[14]/label</xpath>
            <value>
              <!-- EN: Advanced gravship thruster -->
              <label>Propulsor de gravinave avanzado</label>
            </value>
          </li>
        </operations>
      </match>
    </match>
