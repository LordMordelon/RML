<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="GravFieldExtender"]/description</xpath>
          <value>
            <!-- EN: An ultratech device used to increase the size of a gravship. It extends the area in which substructure can be built, and increases the amount of substructure that a gravship can support. Must be built near a grav engine.\n\nA gravship can support up to eight grav field extenders. -->
            <description>Un dispositivo ultratecnológico usado para aumentar el tamaño de una nave gravitacional. Amplía el área en la que se puede construir subestructura y aumenta la cantidad de subestructura que puede soportar una nave gravitacional. Debe construirse cerca de un motor gravitatorio.\n\nUna nave gravitacional puede soportar hasta ocho extensores de campo gravitatorio.</description>
          </value>
        </li>
      </operations>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/completedLetterLabel</xpath>
    <value>
      <!-- EN: Cerebrex node studied: {RESEARCH} unlocked -->
      <completedLetterLabel>Nodo cerebrex estudiado: {RESEARCH} desbloqueado</completedLetterLabel>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/completedLetter</xpath>
    <value>
      <!-- EN: By studying the Cerebrex node, {PAWN_labelShort} has acquired the insight needed for the research project(s) {RESEARCH}.\n\nYour researchers can now use research benches to begin researching how to actually use the technology. -->
      <completedLetter>Al estudiar el nodo cerebrex, {PAWN_labelShort} obtuvo la comprensión necesaria para el/los proyecto(s) de investigación {RESEARCH}.\n\nTus investigadores ya pueden usar los bancos de investigación para empezar a investigar cómo usar realmente esa tecnología.</completedLetter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/activateLabelString</xpath>
    <value>
      <!-- EN: Analyze... -->
      <activateLabelString>Analizar...</activateLabelString>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/activateDescString</xpath>
    <value>
      <!-- EN: Analyze the Cerebrex node. -->
      <activateDescString>Analiza el nodo cerebrex.</activateDescString>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/jobString</xpath>
    <value>
      <!-- EN: Analyze Cerebrex node -->
      <jobString>Analizar nodo cerebrex</jobString>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/guiLabelString</xpath>
    <value>
      <!-- EN: Choose who should analyze this -->
      <guiLabelString>Elige quién debería analizar esto</guiLabelString>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Apparel_CerebrexNode"]/comps/li[1]/inspectString</xpath>
    <value>
      <!-- EN: Can be analyzed by a colonist. -->
      <inspectString>Puede ser analizado por un colono.</inspectString>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[7]/label</xpath>
    <value>
      <!-- EN: Advanced ship AI core -->
      <label>Núcleo de IA de nave avanzado</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/RitualOutcomeEffectDef[defName="GravshipLaunch"]/comps/li[8]/label</xpath>
    <value>
      <!-- EN: Advanced gravship thruster -->
      <label>Propulsor de nave gravitacional avanzado</label>
    </value>
  </Operation>
</Patch>