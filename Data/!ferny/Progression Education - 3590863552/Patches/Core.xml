<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Medieval 2</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="Gunsmithing"]/li[1]/title</xpath>
          <value>
            <!-- EN: Learning to use guns -->
            <title>Aprender a usar armas de fuego</title>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="Gunsmithing"]/li[1]/desc</xpath>
          <value>
            <!-- EN: Your intellectual has been bestowed the understanding of how to operate firearms. Other colonists can now be taught this knowledge in proficiency classes. -->
            <desc>Tu intelectual recibió el conocimiento de cómo operar armas de fuego. Ahora se puede enseñar ese conocimiento a otros colonos en clases de competencia.</desc>
          </value>
        </li>
      </operations>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="Fabrication"]/li[1]/title</xpath>
    <value>
      <!-- EN: High-tech gear -->
      <title>Equipamiento de alta tecnología</title>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ResearchProjectDef[defName="Fabrication"]/li[1]/desc</xpath>
    <value>
      <!-- EN: Your intellectual has been bestowed the understanding of how to operate high-tech gear. Other colonists can now be taught this knowledge in proficiency classes. -->
      <desc>Tu intelectual recibió el conocimiento de cómo operar equipamiento de alta tecnología. Ahora se puede enseñar ese conocimiento a otros colonos en clases de competencia.</desc>
    </value>
  </Operation>
</Patch>