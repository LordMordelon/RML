<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Tribals</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Medieval Overhaul</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ScenarioDef[defName="Ferny_LoneTribal"]/scenario/parts/li[7]/text</xpath>
            <value>
              <!-- EN: You have been alone on this anarchal planet for as long as you can remember. The only flicker of hope being the small burst of flame you had just managed to create. A burst of warmth, power, and most importantly hope. Will you have the strength to take that flicker far enough to exit these horrible conditions? -->
              <text>Has estado solo en este planeta anárquico desde que tienes memoria. El único destello de esperanza es la pequeña llama que acabas de lograr crear. Una ráfaga de calor, poder y, lo más importante, esperanza. ¿Tendrás la fuerza para llevar ese destello lo suficientemente lejos como para salir de estas horribles condiciones?</text>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="GravshipEarth"]/label</xpath>
          <value>
            <!-- EN: New Gravjumper -->
            <label>Nueva Gravinave</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>