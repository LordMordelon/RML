      <li>Vanilla Gravship Expanded - Chapter 2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="VGE_TheGravship"]/label</xpath>
          <value>
            <!-- EN: Gravship Battle -->
            <label>Batalla de gravinaves</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>