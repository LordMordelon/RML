<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Insectoids 2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="VFEI2_MercenarySquad"]/scenario/summary</xpath>
          <value>
            <!-- EN: A group of high-powered mercenaries, diving into an insectoid menace. Can you prevail and conquer? -->
            <summary>Un grupo de mercenarios de élite, sumergiéndose en una amenaza insectoide. ¿Podrás prevalecer y conquistar?</summary>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="VFEI2_MercenarySquad"]/label</xpath>
          <value>
            <!-- EN: Megahive Mercenaries -->
            <label>Mercenarios en Megacolmena</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="VFEI2_MercenarySquad"]/scenario/name</xpath>
          <value>
            <!-- EN: Megahive Mercenaries -->
            <name>Mercenarios en Megacolmena</name>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>