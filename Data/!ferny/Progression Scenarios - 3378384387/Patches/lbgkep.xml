<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="DankPyon_LoneWolfStart"]/scenario/summary</xpath>
          <value>
            <!-- EN: A solo colonist experience. -->
            <summary>Una experiencia de colono en solitario.</summary>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>