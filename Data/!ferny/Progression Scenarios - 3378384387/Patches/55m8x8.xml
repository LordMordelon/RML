<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Tribals</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ScenarioDef[defName="VFET_WildMen"]/scenario/summary</xpath>
          <value>
            <!-- EN: A group of wild men trying to form a tribe. A slightly easier version of True Start. -->
            <summary>Un grupo de hombres salvajes intentando formar una tribu. Una versión un poco más fácil de Inicio Verdadero.</summary>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>