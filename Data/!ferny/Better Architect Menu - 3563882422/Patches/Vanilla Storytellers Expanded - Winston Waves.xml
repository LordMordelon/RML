<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Storytellers Expanded - Winston Waves</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VESWW_RewardDropSpot"]/label</xpath>
          <value>
            <!-- EN: Storyteller reward drop spot -->
            <label>punto de entrega de recompensas del narrador</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>