<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/DesignationCategoryDef[defName="Biotech"]/label</xpath>
          <value>
            <!-- EN: Genetics -->
            <label>Genética</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Anomaly</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/DesignationCategoryDef[defName="Anomaly"]/label</xpath>
          <value>
            <!-- EN: Monolith -->
            <label>Monolito</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>##packageId##inglix.widermarriagespot</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="MarriageSpot"]/label</xpath>
          <value>
            <!-- EN: 2x1 marriage spot -->
            <label>Punto de boda 2x1</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>