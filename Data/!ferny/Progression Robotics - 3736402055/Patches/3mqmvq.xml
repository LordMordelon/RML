<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Apex Mechanoids</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="AdvancedMechtech"]/label</xpath>
          <value>
            <!-- EN: Advanced mechtech -->
            <label>Tecnomeca avanzada</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="ApexMechtech"]/label</xpath>
          <value>
            <!-- EN: Apex mechtech -->
            <label>Tecnomeca ápice</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="APM_Apparel_MechamancerSuit"]/label</xpath>
          <value>
            <!-- EN: mechmancer suit -->
            <label>traje de mecamante</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="APM_Apparel_ArmorHelmetMechamancerHelmet"]/label</xpath>
