<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="BurnoutMechlinkBooster"]/label</xpath>
          <value>
            <!-- EN: warqueen invoker -->
            <label>invocador de reina bélica</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="MechbandDish"]/label</xpath>
          <value>
            <!-- EN: apocriton invoker -->
            <label>invocador de apocritón</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="BasicMechtech"]/label</xpath>
          <value>
            <!-- EN: Mechanoids -->
            <label>Mecanoides</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="StandardMechtech"]/label</xpath>
          <value>
            <!-- EN: Large mech gestator -->
            <label>Gran gestador de mecas</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="HighMechtech"]/label</xpath>
          <value>
            <!-- EN: Subcore ripscanner -->
            <label>Escanecorte de subnúcleos</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>