<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="BasicGravtech"]/label</xpath>
          <value>
            <!-- EN: gravjumper -->
            <label>gravisaltador</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="StandardGravtech"]/label</xpath>
          <value>
            <!-- EN: gravship -->
            <label>gravinave</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="OrbitalTech"]/label</xpath>
          <value>
            <!-- EN: vac barriers -->
            <label>barreras de vacío</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="OrbitalTech"]/description</xpath>
          <value>
            <!-- EN: Construct powered barriers and barrier roofing that prevent depressurization while allowing free passage. -->
            <description>Construye barreras con energía y techos de barrera que evitan la despresurización y permiten el paso libre.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>