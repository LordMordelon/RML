<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="VGE_OxygenNetwork"]/label</xpath>
          <value>
            <!-- EN: oxygen logistics -->
            <label>logística de oxígeno</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/label</xpath>
          <value>
            <!-- EN: astrofuel generator -->
            <label>generador de astrobustible</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/description</xpath>
          <value>
            <!-- EN: Construct a generator that consumes astrofuel to supply power aboard a gravship. -->
            <description>Construye un generador que consume astrobustible para suministrar energía a bordo de una gravinave.</description>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>