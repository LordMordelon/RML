<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Tiger"]/tools/li[1]/label</xpath>
          <value>
            <!-- EN: head -->
            <label>cabeza</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Tiger"]/tools/li[2]/label</xpath>
          <value>
            <!-- EN: left claw -->
            <label>garra izquierda</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Tiger"]/tools/li[3]/label</xpath>
          <value>
            <!-- EN: right claw -->
            <label>garra derecha</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="Tiger"]/tools/li[4]/label</xpath>
          <value>
            <!-- EN: canines -->
            <label>caninos</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Panther"]/tools/li[1]/label</xpath>
    <value>
      <!-- EN: head -->
      <label>cabeza</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Panther"]/tools/li[2]/label</xpath>
    <value>
      <!-- EN: left claw -->
      <label>garra izquierda</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Panther"]/tools/li[3]/label</xpath>
    <value>
      <!-- EN: right claw -->
      <label>garra derecha</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="Panther"]/tools/li[4]/label</xpath>
    <value>
      <!-- EN: canines -->
      <label>caninos</label>
    </value>
  </Operation>
</Patch>