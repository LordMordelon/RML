<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>Vanilla Animals Expanded — Waste Animals</li>
      </mods>
      <nomatch Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="ToxicMeat"]/label</xpath>
            <value>
              <!-- EN: toxic meat -->
              <label>carne tóxica</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="ToxicMeat"]/description</xpath>
            <value>
              <!-- EN: Raw meat from a toxic animal.\n\nChewy, gelatinous and disgusting. -->
              <description>Carne cruda de un animal tóxico.\n\nCorreosa, gelatinosa y asquerosa.</description>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThoughtDef[defName="AteToxicMeatDirect"]/stages/li[1]/label</xpath>
            <value>
              <!-- EN: ate toxic meat -->
              <label>comió carne tóxica</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThoughtDef[defName="AteToxicMeatDirect"]/stages/li[1]/description</xpath>
            <value>
              <!-- EN: I ate some toxic meat. It was, possibly, the most disgusting thing I&apos;ve ever tasted. -->
              <description>Comí algo de carne tóxica. Fue, posiblemente, lo más asqueroso que he probado jamás.</description>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThoughtDef[defName="AteToxicMeatAsIngredient"]/stages/li[1]/label</xpath>
            <value>
              <!-- EN: ate cooked toxic meat -->
              <label>comió carne tóxica cocinada</label>
            </value>
          </li>
          <li Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>/Defs/ThoughtDef[defName="AteToxicMeatAsIngredient"]/stages/li[1]/description</xpath>
            <value>
              <!-- EN: I ate a meal cooked from toxic meat. The seasoning partly covered the taste, but it still tasted quite poisonous. -->
              <description>Comí una comida preparada con carne tóxica. El condimento ocultó en parte el sabor, pero aún así sabía bastante venenosa.</description>
            </value>
          </li>
        </operations>
      </nomatch>
    </match>
  </Operation>
