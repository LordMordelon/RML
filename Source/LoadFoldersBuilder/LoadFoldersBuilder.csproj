<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="YamlDotNet" Version="17.0.1" />
    </ItemGroup>

    <ItemGroup>
      <!-- El lector de textos de traduccion es el mismo que usa el juego para «Ver cambios»
           (PLAN-CAMBIOS-LOCALES.md): asi la clave de un texto es igual en los dos lados. -->
      <Compile Include="../RmlVentana/Logica/TextosDeTraduccion.cs" Link="Logica/TextosDeTraduccion.cs" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="icon.ico" />
    </ItemGroup>

</Project>
