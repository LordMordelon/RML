<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
      Program.cs usa RimworldExtractorInternal.Utils.GenerateFileName, pero RMK
      publica este proyecto sin la referencia: el .exe se compilo desde un setup
      local. Se asume que el fork del extractor esta clonado como carpeta hermana
      de este repositorio. Sobrescribible con:
          dotnet build -p:ExtractorInternalPath=<ruta al .csproj>
    -->
    <PropertyGroup>
        <ExtractorInternalPath Condition="'$(ExtractorInternalPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\RimworldExtractor\RimworldExtractorInternal\RimworldExtractorInternal.csproj</ExtractorInternalPath>
    </PropertyGroup>

    <Target Name="ComprobarExtractor" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(ExtractorInternalPath)')"
               Text="No se encontro RimworldExtractorInternal en '$(ExtractorInternalPath)'. Clona el fork del extractor como carpeta hermana de este repositorio, o pasa -p:ExtractorInternalPath=&lt;ruta&gt;." />
    </Target>

    <ItemGroup>
        <ProjectReference Include="$(ExtractorInternalPath)" />
    </ItemGroup>

</Project>
