# Área de trabajo local: traducciones en curso, sin versionar.
# Mismo criterio que usa RMK.
Data/User/

# Compilación .NET
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# La DLL de RML: la compila LoadFoldersBuilder en -build y -copia.
Common/Assemblies/

# Publicados de las herramientas
Source/**/publish/

# Archivos temporales de Excel generados al traducir
~$*.xlsx
*.xlsx.tmp

# Sistema
Thumbs.db
desktop.ini

# Salida de 02-armar-copia-limpia.cmd: la copia limpia del mod para el Workshop.
output/

# Log de las corridas del extractor. Se rehace en cada una.
extractor.log

# La pagina de los mods mas pedidos: la arma el builder desde la rama solicitudes y la publica
# pagina-diaria.yml sin commitear (ver Source/LoadFoldersBuilder/Solicitudes.cs).
docs/solicitudes.html
